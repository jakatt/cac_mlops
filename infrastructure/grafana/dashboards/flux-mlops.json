        "type": "dashboard"
      },
      {
        "name": "GO (déploiement validé)",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "green",
        "target": {
          "expr": "{service=~\"prefect-worker|gradio\"} |= \"event=gate_resolved\" |= \"decision=GO\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Rollback",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=rollback\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Redémarrage planifié",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=planned_interruption\"",
