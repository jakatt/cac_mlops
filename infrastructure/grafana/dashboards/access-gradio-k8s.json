        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "expr": "probe_success{instance=\"https://kapsule.jakat-inc.fr/gradio-public-health\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Cluster éteint",
          "color": {
