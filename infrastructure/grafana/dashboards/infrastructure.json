    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/cac-infra",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "GO (déploiement validé)",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "green",
        "target": {
          "expr": "{service=~\"prefect-worker|gradio\"} |= \"event=gate_resolved\" |= \"decision=GO\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Rollback",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=rollback\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Redémarrage planifié",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=planned_interruption\"",
          "refId": "Anno"
        }
      }
    ]
  },
