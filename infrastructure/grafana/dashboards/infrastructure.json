    {
      "type": "stat",
      "title": "Nœuds actifs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "description": "**Ce que ça mesure.** Le nombre de machines (nœuds) du cluster Kapsule en service.\n\n**Comment.** kube-state-metrics et node-exporter (dans le cluster) sont relevés toutes les 15 s par le Prometheus du cluster, que Grafana lit via le VPN Tailscale.\n\n**Lecture.** « Cluster éteint » = état normal hors démonstration (kapsule-up / kapsule-down).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "expr": "count(up{job=\"node-exporter\"} == 1)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Cluster éteint",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              },
              {
                "color": "blue",
                "value": -1000000000000.0
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 12,
