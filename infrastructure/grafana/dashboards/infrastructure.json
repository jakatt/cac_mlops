    {
      "type": "stat",
      "title": "Connexions nginx actives",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "**Ce que ça mesure.** Le nombre de connexions HTTP ouvertes en ce moment sur nginx (reverse proxy de tous les accès du VPS).\n\n**Comment.** nginx-exporter lit la page d'état de nginx (`stub_status`) ; relevé toutes les 15 s.\n\n**Lecture.** Quelques connexions = normal (sondes, Cockpit ouvert). Un pic soudain peut signaler un abus.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nginx_connections_active",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
