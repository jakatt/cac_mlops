    {
      "type": "stat",
      "title": "CPU utilisé",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "**Ce que ça mesure.** L'occupation moyenne du processeur du VPS sur les 5 dernières minutes, tous cœurs confondus.\n\n**Comment.** node-exporter (conteneur du VPS) lit les compteurs du système Linux ; le Prometheus du VPS les relève toutes les 15 s. Calcul : 100 % moins la part de temps où les cœurs sont inactifs.\n\n**Lecture.** Vert < 70 % · orange < 90 % · rouge au-delà. Des pics pendant un entraînement ou un build sont normaux.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
