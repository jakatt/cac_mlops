{
  "uid": "cac-mlops-home",
  "title": "CAC MLOps — Vue d'ensemble",
  "description": "Page d'accueil : santé des 4 accès publics, modèle, alertes, événements.",
  "tags": [
    "cac-mlops",
    "home"
  ],
  "schemaVersion": 38,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "title": "Vue d'ensemble",
      "type": "link",
      "url": "/d/cac-mlops-home",
      "icon": "dashboard"
    },
    {
      "title": "Accès",
      "type": "dashboards",
      "tags": [
        "cac-access"
      ],
      "asDropdown": true,
      "icon": "external link"
    },
    {
      "title": "Flux MLOps",
      "type": "link",
      "url": "/d/cac-flux",
      "icon": "dashboard"
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/cac-infra",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "GO (déploiement validé)",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "green",
        "target": {
          "expr": "{service=~\"prefect-worker|gradio\"} |= \"event=gate_resolved\" |= \"decision=GO\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Rollback",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=rollback\"",
          "refId": "Anno"
        }
      },
      {
        "name": "Redémarrage planifié",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "expr": "{service=\"prefect-worker\"} |= \"event=planned_interruption\"",
          "refId": "Anno"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## CAC MLOps — Vue d'ensemble\nLes 4 accès publics, le modèle en production et les derniers événements. Cliquer sur un statut ouvre le dashboard de l'accès."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Accès publics — sonde bout-en-bout, période choisie",
